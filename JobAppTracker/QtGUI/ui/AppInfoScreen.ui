      <item row="10" column="1">
       <layout class="QHBoxLayout" name="horizontalLayout_5">
        <item>
         <widget class="QComboBox" name="statusField">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Current application status.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="whatsThis">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Set the current status of this application. The following statuses can be set:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Pending&lt;/span&gt;: Default state, used if the application is currently still pending.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Offered&lt;/span&gt;: Used if the company has extended a job offer (Yipee!)&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Rejected&lt;/span&gt;: Used if the company has sent a rejection email for the position.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Declined&lt;/span&gt;: Used if you have withdrawn your application for this position, or declined the position before the offer.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Cancelled&lt;/span&gt;: Like the &lt;span style=&quot; font-style:italic;&quot;&gt;rejected&lt;/span&gt; option, but only if the email specifies that the company has decided not to fill the position as opposed to rejecting based on your candidacy.&lt;/p&gt;&lt;p&gt;The following states cannot be selected, but might appear:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Interview&lt;/span&gt;: If the application is still pending and has had an interview. Automatically set when an interview date is added.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Likely ghosted&lt;/span&gt;: Appears if the application is still marked &lt;span style=&quot; font-style:italic;&quot;&gt;pending&lt;/span&gt; and the application has passed the ghosting prediction threshold (3 weeks after applying).&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <item>
           <property name="text">
            <string>Pending</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Offered</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Rejected</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Declined</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Cancelled</string>
           </property>
          </item>
         </widget>
        </item>
